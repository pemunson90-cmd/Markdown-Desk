package com.example.markdowndesk;
import java.util.*;
import java.util.function.IntConsumer;
class ActivityBase {void onStop(){} public void onConfigurationChanged(MainActivity.Configuration c){}}
final class MainActivity extends ActivityBase {
 static final int MODE_EDIT=0,MODE_PREVIEW=1,MODE_SPLIT=2,MAX_TABS=12;
 static class android {static class R {static class id {static final int undo=1,redo=2;}}}
 static final class Configuration {}
 interface DialogInterface {}
 static final class Uri {String value;Uri(String v){value=v;}static Uri parse(String v){return new Uri(v);}static String decode(String v){return v;}}
 static final class RecentStore {
  static final class Item {final String name,uri;Item(String n,String u){name=n;uri=u;}}
  static List<Item> read(MainActivity a){return new ArrayList<>(a.recents);}
 }
 static final class Toast {static Toast makeText(MainActivity a,String text,int i){a.toasts.add(text);return new Toast();}void show(){}}
 static final class Editor {String text="# One\nbody\n## Two\nmore\n# One\n";CharSequence getText(){return text;}}
 final class SourceNavigation {final int revisionAt=revision;final int modeAt=mode;SourceNavigation(int offset){}}
 boolean isCurrentSourceNavigation(SourceNavigation n){return n.revisionAt==revision&&n.modeAt==mode;}
 final Editor editor=new Editor(); final List<RecentStore.Item> recents=new ArrayList<>();
 final List<String> calls=new ArrayList<>(),toasts=new ArrayList<>();
 UiTheme.Palette palette=UiTheme.palette(1,true); int mode=0,revision=0;long downloadsRequest;boolean finishing,destroyed;
 boolean isFinishing(){return finishing;}boolean isDestroyed(){return destroyed;}
 void record(String s){calls.add(s);}
