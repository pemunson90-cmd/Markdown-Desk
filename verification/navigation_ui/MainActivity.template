 void jumpToSourceOffset(int offset){record("source:"+offset);}void scrollPreviewToSourceOffset(int offset){record("preview:"+offset);}
 void captureActiveTab(){record("capture");}void rebuildBody(){record("body");}void applyResponsiveChrome(){record("chrome");}void refreshFilesRail(){record("rail");}
 void commands(){showCommandPalette();}void recent(){showRecents();}void outline(){showOutline();}
