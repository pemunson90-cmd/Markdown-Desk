}
/** Only Android picker boundary is modeled; choices and Activity methods are production. */
final class NavigationPicker {
 static NavigationPicker latest;
 final NavigationChoices choices; NavigationChoices.Snapshot displayed;
 final String title; IntConsumer callback;boolean closed;
 NavigationPicker(String t,List<NavigationChoices.Row> rows,IntConsumer c){title=t;choices=new NavigationChoices(rows);displayed=choices.filter("");callback=c;}
 static NavigationPicker show(MainActivity a,UiTheme.Palette p,String t,String h,List<NavigationChoices.Row> rows,IntConsumer c){return latest=new NavigationPicker(t,rows,c);}
 void filter(String s){displayed=choices.filter(s);}void click(int index){NavigationChoices.Row r=choices.choose(displayed,index);if(r==null)return;IntConsumer c=callback;dismiss();if(c!=null)c.accept(r.id);}
 void dismiss(){closed=true;choices.cancel();callback=null;}
}
