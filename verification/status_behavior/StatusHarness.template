    static final class CountedText implements CharSequence {
        final String source;
        int copies;
        CountedText(String source) { this.source = source; }
        public int length() { return source.length(); }
        public char charAt(int index) { return source.charAt(index); }
        public CharSequence subSequence(int start, int end) { return source.subSequence(start, end); }
        public String toString() { copies++; return new String(source.toCharArray()); }
    }
    static final class Editor {
        CountedText text;
        int selection;
        Editor(String source) { text = new CountedText(source); }
        CharSequence getText() { return text; }
        int length() { return text.length(); }
    }
    static final class Resources {
        String getQuantityString(int id, int quantity, Integer formatted) {
            String noun = id == R.plurals.word_count ? "word" : "character";
            return formatted + " " + noun + (quantity == 1 ? "" : "s");
        }
    }
    interface Editable extends CharSequence {}
    interface TextWatcher {
        void beforeTextChanged(CharSequence text, int start, int count, int after);
        void onTextChanged(CharSequence text, int start, int before, int count);
        void afterTextChanged(Editable text);
    }
    static final class QueueExecutor extends AbstractExecutorService {
        final ArrayDeque<Runnable> tasks = new ArrayDeque<>();
        boolean stopped;
        public void execute(Runnable task) { if (stopped) throw new RejectedExecutionException(); tasks.add(task); }
        public void shutdown() { stopped = true; }
        public List<Runnable> shutdownNow() { stopped = true; List<Runnable> pending = new ArrayList<>(tasks); tasks.clear(); return pending; }
        public boolean isShutdown() { return stopped; }
        public boolean isTerminated() { return stopped && tasks.isEmpty(); }
        public boolean awaitTermination(long timeout, TimeUnit unit) { return isTerminated(); }
        void drain() { while (!tasks.isEmpty()) tasks.remove().run(); }
    }
    static final class Executors { static QueueExecutor newSingleThreadExecutor() { return new QueueExecutor(); } }
    static final class Handler {
        final ArrayDeque<Runnable> delayed = new ArrayDeque<>(), posted = new ArrayDeque<>();
        void post(Runnable runnable) { posted.add(runnable); }
        void postDelayed(Runnable runnable, long delay) {
            if (delay != 250L) throw new AssertionError("Unexpected debounce delay: " + delay);
            delayed.add(runnable);
        }
        void removeCallbacks(Runnable runnable) { delayed.remove(runnable); posted.remove(runnable); }
        void removeCallbacksAndMessages(Object token) { delayed.clear(); posted.clear(); }
        void runDelayed() { while (!delayed.isEmpty()) delayed.remove().run(); }
        void runPosted() { while (!posted.isEmpty()) posted.remove().run(); }
    }
    final List<DocumentTab> tabs = new ArrayList<>();
    int activeTab = -1;
    boolean suppressChanges;
    final Handler main = new Handler();
    final QueueExecutor io = new QueueExecutor(), renderIo = new QueueExecutor();
