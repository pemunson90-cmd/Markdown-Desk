    static final class Provider {
        final Map<String,byte[]> bytes=new HashMap<>();
        int writes,reads; String fault; final List<String> writeUris=new ArrayList<>();
        byte[] read(Uri uri)throws IOException{reads++;if("read".equals(fault))throw new IOException("modeled revoked read permission");return bytes.getOrDefault(uri.toString(),new byte[0]).clone();}
        void write(Uri uri,byte[] data)throws IOException{
            writes++;writeUris.add(uri.toString());
            if("write".equals(fault))throw new IOException("modeled provider write failure");
            bytes.put(uri.toString(),"mismatch".equals(fault)?new byte[]{0x78}:data.clone());
        }
    }
    static final class DocumentIO {
