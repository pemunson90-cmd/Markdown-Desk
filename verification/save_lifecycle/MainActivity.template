        static Metadata metadata(Provider provider,Uri uri){Metadata m=new Metadata();m.displayName="destination.md";m.lastModified=200L;return m;}
        static byte[] encode(String text,boolean bom){return (bom?"\uFEFF"+text:text).getBytes(StandardCharsets.UTF_8);}
        static ReadResult read(Provider provider,Uri uri)throws IOException{ReadResult r=new ReadResult();r.sourceBytes=provider.read(uri);return r;}
        static void write(Provider provider,Uri uri,byte[] data)throws IOException{provider.write(uri,data);}
    }
